<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
             x:Class="LifeManagementApp.Views.AddTodoPage"
             x:DataType="vm:AddTodoViewModel"
             Title="Uusi tehtävä">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20">

            <!-- VIRHEILMOITUS VALIDOINNISTA -->
            <Label Text="{Binding ErrorMessage}" 
                   TextColor="#DC2626" FontSize="14" FontAttributes="Bold" 
                   IsVisible="{Binding ErrorMessage, Converter={x:Null}}" />

            <!-- OTSIKKO -->
            <Label Text="Tehtävän kuvaus *" FontSize="14" FontAttributes="Bold" TextColor="#334155" />
            <Entry Placeholder="Esim. Tee fysiikan laboratorioraportti" 
                   Text="{Binding Title}" 
                   FontSize="16" />

            <!-- PRIORITEETTI -->
            <Label Text="{Binding Priority, StringFormat='Prioriteetti: {0} (1=Matala, 5=Korkea)'}" 
                   FontSize="14" FontAttributes="Bold" TextColor="#334155" Margin="0,10,0,0" />
            <Stepper Minimum="1" Maximum="5" Increment="1" Value="{Binding Priority}" />

            <!-- ERÄPÄIVÄ -->
            <Label Text="Eräpäivä" FontSize="14" FontAttributes="Bold" TextColor="#334155" Margin="0,10,0,0" />
            <DatePicker Date="{Binding DueDate}" Format="dd.MM.yyyy" />

            <!-- KATEGORIAVALINTA (RELAATIO 1-N) -->
            <Label Text="Kategoria" FontSize="14" FontAttributes="Bold" TextColor="#334155" Margin="0,10,0,0" />
            <Picker ItemsSource="{Binding Categories}" 
                    ItemDisplayBinding="{Binding Name}" 
                    SelectedItem="{Binding SelectedCategory}" 
                    Title="Valitse kategoria" />

            <!-- NAPIT -->
            <HorizontalStackLayout Spacing="12" Margin="0,20,0,0">
                <Button Text="Tallenna" 
                        Command="{Binding SaveTodoCommand}" 
                        BackgroundColor="#2563EB" TextColor="White" FontAttributes="Bold" CornerRadius="8" WidthRequest="140" />
                <Button Text="Peruuta" 
                        Command="{Binding CancelCommand}" 
                        BackgroundColor="#E2E8F0" TextColor="#334155" CornerRadius="8" WidthRequest="100" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>