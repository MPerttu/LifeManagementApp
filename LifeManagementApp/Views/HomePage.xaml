<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
             xmlns:models="clr-namespace:LifeManagementApp.Models"
             xmlns:converters="clr-namespace:LifeManagementApp.Converters"
             x:Class="LifeManagementApp.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="Koti">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:PriorityToColorConverter x:Key="PriorityToColor" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20">

            <!-- LATAUSHUIPPU (ActivityIndicator) -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                               IsVisible="{Binding IsLoading}" 
                               Color="#2563EB" 
                               HorizontalOptions="Center" />

            <!-- SÄÄ-KORTTI (Dynaaminen kaupunki ja tuntiennuste) -->
            <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16" BackgroundColor="#F8FAFC">
                <VerticalStackLayout Spacing="8">

                    <!-- SÄÄKUVAUS (esim. "Selkeää") -->
                    <Label Text="{Binding WeatherDescriptionText}" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                    <!-- Kaupungin nimi tulee suoraan Preferences-asetuksista -->
                    <Label Text="{Binding LocationTitle, StringFormat='Tämänhetkinen sää ({0})'}" 
                           FontSize="18" FontAttributes="Bold" TextColor="#1E293B" />

                    <!-- Lämpötila ja tuuli omalla vaakarivillään -->
                    <HorizontalStackLayout Spacing="24">
                        <Label Text="{Binding TemperatureText, StringFormat='Lämpötila: {0}'}" FontSize="15" TextColor="#334155" />
                        <Label Text="{Binding WindSpeedText, StringFormat='Tuuli: {0}'}" FontSize="15" TextColor="#334155" />
                    </HorizontalStackLayout>

                    <!-- B2 Bonus: Paras kite-ikkuna tänään -->
                    <Label Text="{Binding BestKiteWindowText}" 
                           FontSize="13" 
                           FontAttributes="Italic" 
                           TextColor="#0284C7" 
                           Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- KITESURF-HÄLYTYS (Näkyy vain, jos tuuliraja ylittyy) -->
            <Border IsVisible="{Binding IsKiteSurfVisible}" 
                    Stroke="#10B981" StrokeThickness="2" StrokeShape="RoundRectangle 12" 
                    Padding="14" BackgroundColor="#ECFDF5">
                <Label Text="{Binding KiteSurfStatus}" FontSize="15" FontAttributes="Bold" TextColor="#065F46" />
            </Border>

            <!-- PÄIVITÄ-PAINIKE -->
            <Button Text="Päivitä tiedot" 
                    Command="{Binding LoadDataCommand}" 
                    BackgroundColor="#2563EB" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    HeightRequest="44"
                    CornerRadius="8" />

            <!-- TOP 3 TEHTÄVÄT -->
            <Label Text="Top 3 tärkeintä tehtävää" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" Margin="0,10,0,0" />

            <CollectionView ItemsSource="{Binding Top3Todos}">
                <CollectionView.EmptyView>
                    <Label Text="Ei keskeneräisiä tehtäviä juuri nyt!" 
                           TextColor="#64748B" FontAttributes="Italic" HorizontalTextAlignment="Center" Margin="20" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TodoItem">
                        <Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12" Margin="0,4" BackgroundColor="White">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                                    <Label Text="{Binding Category.Name, FallbackValue='Yleinen'}" FontSize="12" TextColor="#2563EB" FontAttributes="Italic" />
                                </VerticalStackLayout>
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding DueDate, StringFormat='Eräpäivä: {0:dd.MM.yyyy}'}" FontSize="13" TextColor="#64748B" />

                                <!-- Prioriteetin väri konvertterilla -->
                                <Border Grid.RowSpan="2" Grid.Column="1" StrokeThickness="0" 
                                        BackgroundColor="{Binding Priority, Converter={StaticResource PriorityToColor}}" 
                                        StrokeShape="RoundRectangle 6" Padding="8,4" VerticalOptions="Center">
                                    <Label Text="{Binding Priority, StringFormat='Taso {0}'}" FontSize="12" FontAttributes="Bold" TextColor="#1E293B" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>